@model DBStoreSport.Models.StoreHomeViewModel

@{
    ViewBag.Title = "Trang chủ cửa hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="store-container">
    <aside class="sidebar">
        <h3 class="section-title">Danh mục</h3>
        <ul class="category-list">
            <li>
                <a href="@Url.Action("Index", "Store")">Tất cả sản phẩm</a>
            </li>
            @foreach (var category in Model.Categories)
            {
                <li>
                    <a href="@Url.Action("Index", "Store", new { categoryId = category.CategoryID, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <section class="main-content">
        <h2 class="section-title">Tất cả sản phẩm</h2>

        <div class="catalog-toolbar">
            @using (Html.BeginForm("Index", "Store", FormMethod.Get, new { @class = "catalog-search" }))
            {
                if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                }

                <input type="text" name="keyword" value="@Model.SearchTerm" placeholder="Tìm tên hoặc mô tả..." />
                <input type="number" name="minPrice" value="@Model.MinPrice" min="0" step="1000" placeholder="Giá từ" />
                <input type="number" name="maxPrice" value="@Model.MaxPrice" min="0" step="1000" placeholder="Giá đến" />

                <button type="submit" class="btn-brand">Tìm kiếm</button>
                <a class="btn-soft" href="@Url.Action("Index", "Store")">Xóa lọc</a>
            }
        </div>

        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var item in Model.Products)
                {
                    <article class="product-card">
                        <div class="product-image">
                            <img src="~/Content/images/@item.ImagePro" alt="@item.NamePro" />
                        </div>
                        <div class="product-body">
                            <div style="color:#64748b;font-size:13px;">@item.CategoryName</div>
                            <div class="product-name">@item.NamePro</div>
                            <div class="product-description">@item.ShortDescription</div>
                            <div class="product-price">
                                @(item.Price.HasValue ? item.Price.Value.ToString("#,##0") : "0") đ
                            </div>
                            <div class="product-actions">
                                @Html.ActionLink("Chi tiết", "Details", "Products", new { id = item.ProductID }, new { @class = "btn-soft" })
                                <a class="btn-brand" href="#">Mua</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty">
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>Không có sản phẩm nào phù hợp với các điều kiện lọc hoặc từ khóa đang chọn.</p>
                <a class="btn-brand" href="@Url.Action("Index", "Store")">Xem tất cả sản phẩm</a>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="store-pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", "Store", new { categoryId = Model.SelectedCategoryId, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, page = Model.CurrentPage - 1 })">← Trước</a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="active">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Store", new { categoryId = Model.SelectedCategoryId, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, page = i })">@i</a>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", "Store", new { categoryId = Model.SelectedCategoryId, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, page = Model.CurrentPage + 1 })">Sau →</a>
                }
            </div>
        }
    </section>
</div>